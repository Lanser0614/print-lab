{
    "preset": "laravel",
    "rules": {
        "new_with_braces": {
            "anonymous_class": false,
            "named_class": false
        },
        "ordered_imports": {
            "sort_algorithm": "length"
        },

        "no_superfluous_phpdoc_tags": false,
        "phpdoc_no_empty_return": false,
        "phpdoc_trim": false,
        "phpdoc_trim_consecutive_blank_line_separation": false,
        "phpdoc_align": true
    }
}
